# Sao chép sang .env rồi điền giá trị thật. KHÔNG commit .env.
# Mọi khoá ở đây được đọc bởi backend/app/core/config.py.

# ── Cơ sở dữ liệu ───────────────────────────────────────────────
# Đổi tên DB cuối chuỗi để chuyển giữa dữ liệu Đà Nẵng và toàn quốc:
#   gis_tourism  — Đà Nẵng (dùng cho benchmark luận văn)
#   gis_vietnam  — toàn quốc
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gis_tourism
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── LLM ─────────────────────────────────────────────────────────
# ollama = mô hình cục bộ; deepseek = API từ xa (cần DEEPSEEK_API_KEY).
# LƯU Ý: mọi số benchmark trong docs/ đo trên ollama. Đổi provider
# thì số latency không còn so sánh được.
LLM_PROVIDER=ollama
LLM_TIMEOUT=300         # timeout chung (lịch trình AI)
LLM_TIMEOUT_SQL=300     # sinh IR/SQL. 120s KHÔNG đủ cho 7b trên máy 4 GB VRAM
LLM_TIMEOUT_EXPLAIN=180 # diễn giải kết quả bằng lời
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=

# Phạm vi địa lý ghi trong prompt của trợ lý AI. Phải khớp với DATABASE_URL:
# "Việt Nam" cho gis_vietnam, "Đà Nẵng" cho gis_tourism. Đặt sai thì trợ lý coi
# mọi địa danh ngoài phạm vi là không trả lời được.
DB_SCOPE=Việt Nam

# ── Tài khoản khởi tạo lần đầu ──────────────────────────────────
# Chỉ được tạo khi bảng users còn trống. ĐỔI trước khi triển khai thật.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin
SEED_USER_EMAIL=user@gmail.com
SEED_USER_PASSWORD=123456

# ── Bảo mật ─────────────────────────────────────────────────────
# BẮT BUỘC, không có mặc định. Sinh bằng:  openssl rand -hex 32
# Giá trị cũ "danang_gis_tourism_secret_key_12345" ĐÃ LỘ trên GitHub,
# config.py sẽ từ chối nếu bạn dùng lại nó.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Ghi log ─────────────────────────────────────────────────────
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text         # text (dễ đọc) | json (cho log aggregator)
LOG_FILE=               # bỏ trống = chỉ ghi stdout
LOG_SQL=false           # true = ghi MỌI câu SQL ở mức DEBUG. Rất ồn.
LOG_SLOW_QUERY_MS=500   # câu SQL chậm hơn ngưỡng luôn ghi WARNING

# ── Định tuyến ──────────────────────────────────────────────────
MAX_SNAP_DISTANCE_METERS=1500
MIN_COMPONENT_SIZE=100

# ── Hiển thị bản đồ ─────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=
ROADS_SIMPLIFY_TOLERANCE=0.00005
ROADS_FEATURE_LIMIT=20000

# ── Trình biên dịch IR ──────────────────────────────────────────
IR_MAX_LIMIT=100
IR_DEFAULT_LIMIT=20
IR_MAX_ATTEMPTS=3
