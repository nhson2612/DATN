.PHONY: dev build clean test dump restore

dev:
	./dev.sh

db:
	docker compose up -d

backend:
	cd backend && ./venv/bin/uvicorn app.main:app --reload --port 8000

frontend:
	cd web && npm run dev

test:
	cd backend && ./venv/bin/python -m unittest discover -s tests

# ── Chuyển máy ──────────────────────────────────────────────────
# DB=gis_tourism make dump   để lấy bản Đà Nẵng (40 MB) thay vì toàn quốc.
DB ?= gis_vietnam

dump:
	docker exec gis_db pg_dump -U postgres -d $(DB) -Fc -Z6 -f /tmp/$(DB).dump
	docker cp gis_db:/tmp/$(DB).dump ./$(DB).dump
	docker exec gis_db rm -f /tmp/$(DB).dump
	@ls -lh ./$(DB).dump

restore:
	docker compose up -d
	@until docker exec gis_db pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done
	docker cp ./$(DB).dump gis_db:/tmp/$(DB).dump
	-docker exec gis_db psql -U postgres -c "CREATE DATABASE $(DB);"
	docker exec gis_db pg_restore -U postgres -d $(DB) -j4 /tmp/$(DB).dump
	docker exec gis_db rm -f /tmp/$(DB).dump
	@docker exec gis_db psql -U postgres -d $(DB) -tc \
	  "SELECT 'poi='||(SELECT count(*) FROM poi)||' chi_muc_trgm='||(SELECT count(*) FROM pg_indexes WHERE indexname LIKE '%trgm%');"
